{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive.local/schemas/amep-manifest-v1.schema.json",
  "title": "AMEP Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "protocol_version",
    "message_id",
    "correlation_id",
    "sender",
    "recipient",
    "message_type",
    "schema",
    "payload",
    "reply_to",
    "complete",
    "created_at_unix_ns"
  ],
  "properties": {
    "protocol": {
      "const": "adaptive-message-exchange-protocol"
    },
    "protocol_version": {
      "const": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "sender": {
      "type": "string",
      "minLength": 1
    },
    "recipient": {
      "type": "string",
      "minLength": 1
    },
    "message_type": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "content_type",
        "bytes",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "enum": [
            "application/json",
            "text/plain",
            "text/markdown"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "complete": {
      "const": true
    },
    "created_at_unix_ns": {
      "type": "integer",
      "minimum": 0
    }
  }
}
