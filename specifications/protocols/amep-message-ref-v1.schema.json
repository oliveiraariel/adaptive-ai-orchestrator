{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive.local/schemas/amep-message-ref-v1.schema.json",
  "title": "AMEP Message Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol",
    "version",
    "message_id",
    "correlation_id",
    "sender",
    "recipient",
    "message_type",
    "manifest",
    "manifest_sha256",
    "reference_sha256"
  ],
  "properties": {
    "type": {
      "const": "adaptive.message.ref"
    },
    "protocol": {
      "const": "adaptive-message-exchange-protocol"
    },
    "version": {
      "const": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "sender": {
      "type": "string",
      "minLength": 1
    },
    "recipient": {
      "type": "string",
      "minLength": 1
    },
    "message_type": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "reference_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
