{
  "schema_version": 1,
  "bootstrap_version": "1.0.1",
  "platform": {
    "os": "linux",
    "supported_family": ["linuxmint", "ubuntu", "debian", "debian-like"]
  },
  "repositories": {
    "adaptive": {
      "url": "https://github.com/oliveiraariel/adaptive-ai-orchestrator.git",
      "branch": "main",
      "directory": "adaptive-ai-orchestrator"
    },
    "skills": {
      "url": "https://github.com/oliveiraariel/ariel-agent-skills.git",
      "branch": "main",
      "directory": "ariel-agent-skills"
    }
  },
  "runtime": {
    "python_minimum": "3.12",
    "openclaw_minimum": "2026.9.2",
    "openclaw_install_channel": "stable",
    "openclaw_gateway_url": "ws://127.0.0.1:18789",
    "primary_agent": "main"
  },
  "security": {
    "gateway_auth_mode": "token",
    "secret_provider_alias": "adaptive_gateway_file",
    "secret_file": "~/.openclaw/secrets/adaptive-gateway-token.txt",
    "secret_file_mode": "0600",
    "skill": "adaptive-orchestrator-bridge",
    "skill_primary_env": "OPENCLAW_GATEWAY_TOKEN"
  },
  "launchers": {
    "bin_directory": "~/.local/bin",
    "commands": [
      "adaptive-openclaw-setup",
      "adaptive-openclaw-update",
      "adaptive-openclaw-verify"
    ],
    "persist_path_in_shell_startup": true,
    "same_shell_caveat": "A bootstrap subprocess cannot mutate the already-running parent shell PATH; open a new terminal or export ~/.local/bin for that shell."
  },
  "validation": {
    "adaptive_unit_tests": true,
    "skills_registry_validation": true,
    "gateway_rpc_probe": true,
    "outbound_marker": "ADAPTIVE_BOOTSTRAP_OUTBOUND_OK",
    "multiagent_fan_in_marker": "ADAPTIVE_MULTIAGENT_FANIN_OK",
    "minimum_parallelism_observed": 3,
    "inbound_skill_entrypoint": "/skill adaptive-orchestrator-bridge",
    "inbound_semantic_history_fallback": true,
    "inbound_formatting_is_not_authoritative": true
  }
}
